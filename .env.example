# This example is public. Keep real deployment values in Docker Manager.
# Never upload a filled .env or passwords to GitHub.

# Optional image override for local development; production Compose is preconfigured.
BOOKNEST_IMAGE=ghcr.io/hamzaarshad-exe/booknest:latest
BOOKNEST_DOMAIN=booking.example.com
BOOKNEST_BUSINESS_NAME=Your Business
BOOKNEST_OWNER_NAME=Business Owner
BOOKNEST_OWNER_EMAIL=you@example.com
BOOKNEST_OWNER_PASSWORD=
BOOKNEST_DB_PASSWORD=
BOOKNEST_DB_ROOT_PASSWORD=
BOOKNEST_TIMEZONE=Asia/Karachi
BOOKNEST_CURRENCY=PKR
BOOKNEST_RECOVERY_KEY=
